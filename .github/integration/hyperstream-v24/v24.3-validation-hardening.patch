index 0000000..1155900
--- /dev/null
+++ b/scripts/tests/test_hyperstream_workspace_lock.py
@@ -0,0 +1,60 @@
+import shutil
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[2]
+CHECK = ROOT / "scripts" / "check-hyperstream-workspace-lock.py"
+
+
+class HyperstreamWorkspaceLockTests(unittest.TestCase):
+    def make_fixture(self):
+        tmp = tempfile.TemporaryDirectory()
+        root = Path(tmp.name)
+        shutil.copy2(ROOT / "Cargo.toml", root / "Cargo.toml")
+        shutil.copy2(ROOT / "Cargo.lock", root / "Cargo.lock")
+        return tmp, root
+
+    def run_check(self, root: Path):
+        return subprocess.run(
+            ["python3", str(CHECK), str(root)],
+            text=True,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            check=False,
+        )
+
+    def test_current_locked_workspace_passes(self):
+        result = self.run_check(ROOT)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn("PASS:", result.stdout)
+
+    def test_missing_hyperstream_lock_record_fails(self):
+        tmp, root = self.make_fixture()
+        self.addCleanup(tmp.cleanup)
+        text = (root / "Cargo.lock").read_text()
+        start = text.index('[[package]]\nname = "xenia-hyperstream"\n')
+        end = text.index('[[package]]\nname = "xenia-hyperstream-auth"\n', start)
+        (root / "Cargo.lock").write_text(text[:start] + text[end:])
+        result = self.run_check(root)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("xenia-hyperstream", result.stderr)
+
+    def test_peer_core_sha2_lock_edge_is_required(self):
+        tmp, root = self.make_fixture()
+        self.addCleanup(tmp.cleanup)
+        text = (root / "Cargo.lock").read_text()
+        marker = 'name = "xenia-peer-core"\n'
+        start = text.index(marker)
+        end = text.index('\n[[package]]', start)
+        block = text[start:end].replace(' "sha2 0.10.9",\n', '', 1)
+        (root / "Cargo.lock").write_text(text[:start] + block + text[end:])
+        result = self.run_check(root)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("sha2 0.10.9", result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
