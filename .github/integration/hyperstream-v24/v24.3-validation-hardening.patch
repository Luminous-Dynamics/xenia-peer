+#!/usr/bin/env python3
+"""Fail closed when Hyperstream workspace membership and Cargo.lock drift apart."""
+
+from __future__ import annotations
+
+import argparse
+import sys
+import tomllib
+from pathlib import Path
+
+HYPERSTREAM_MEMBERS = (
+    "crates/xenia-hyperstream",
+    "crates/xenia-hyperstream-auth",
+)
+
+EXPECTED_LOCK_DEPS = {
+    "xenia-hyperstream": ["serde", "sha2 0.10.9", "thiserror 2.0.18"],
+    "xenia-hyperstream-auth": [
+        "ed25519-dalek 2.2.0",
+        "serde",
+        "sha2 0.10.9",
+        "thiserror 2.0.18",
+        "uuid",
+        "xenia-handshake",
+        "xenia-hyperstream",
+        "xenia-ledger",
+        "xenia-peer-core",
+    ],
+}
+
+
+def fail(message: str) -> None:
+    print(f"FAIL: {message}", file=sys.stderr)
+    raise SystemExit(1)
+
+
+def load_toml(path: Path) -> dict:
+    try:
+        with path.open("rb") as handle:
+            return tomllib.load(handle)
+    except (OSError, tomllib.TOMLDecodeError) as exc:
+        fail(f"cannot parse {path}: {exc}")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("root", nargs="?", default=".")
+    args = parser.parse_args()
+    root = Path(args.root).resolve()
+
+    workspace = load_toml(root / "Cargo.toml").get("workspace", {})
+    members = workspace.get("members", [])
+    default_members = workspace.get("default-members", [])
+    for member in HYPERSTREAM_MEMBERS:
+        if member not in members:
+            fail(f"root workspace is missing member {member}")
+        if member not in default_members:
+            fail(f"root workspace default-members is missing {member}")
+
+    lock = load_toml(root / "Cargo.lock")
+    by_name: dict[str, list[dict]] = {}
+    for package in lock.get("package", []):
+        by_name.setdefault(package.get("name", ""), []).append(package)
+
+    for name, expected_deps in EXPECTED_LOCK_DEPS.items():
+        matches = [pkg for pkg in by_name.get(name, []) if "source" not in pkg]
+        if len(matches) != 1:
+            fail(f"expected exactly one local lock record for {name}; found {len(matches)}")
+        package = matches[0]
+        if package.get("version") != "0.0.0-m0":
+            fail(f"unexpected locked version for {name}: {package.get('version')!r}")
+        if package.get("dependencies", []) != expected_deps:
+            fail(
+                f"locked dependencies for {name} drifted: "
+                f"expected {expected_deps!r}, got {package.get('dependencies', [])!r}"
+            )
+
+    peer_core = [pkg for pkg in by_name.get("xenia-peer-core", []) if "source" not in pkg]
+    if len(peer_core) != 1:
+        fail(f"expected exactly one local lock record for xenia-peer-core; found {len(peer_core)}")
+    if "sha2 0.10.9" not in peer_core[0].get("dependencies", []):
+        fail("xenia-peer-core lock record is missing sha2 0.10.9")
+
+    print("PASS: Hyperstream root workspace and Cargo.lock are coherent")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
