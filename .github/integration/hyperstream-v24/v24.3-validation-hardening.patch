+# Hyperstream promotion is security-sensitive: keep the full historical gate
+# chain and the locked-workspace representation in normal validation so source,
+# evidence, workspace, or lock drift cannot wait for a one-off release ceremony.
+if command -v python3 >/dev/null 2>&1; then
+  if [[ -x scripts/check-hyperstream-workspace-lock.py ]]; then
+    run python3 scripts/check-hyperstream-workspace-lock.py .
+  else
+    warn "scripts/check-hyperstream-workspace-lock.py not found or not executable"
+  fi
+
+  if [[ -d crates/xenia-hyperstream/test-vectors ]]; then
+    for gate in 2 3 4 5 6 7 9; do
+      gate_test="crates/xenia-hyperstream/test-vectors/test_security_lane_gate_v${gate}.py"
+      if [[ -f "$gate_test" ]]; then
+        run python3 "$gate_test"
+      else
+        warn "missing Hyperstream security-lane regression: $gate_test"
+      fi
+    done
+  else
+    warn "Hyperstream test-vector directory not found; skipping security-lane regressions"
+  fi
+else
+  warn "python3 not found; skipping Hyperstream workspace/security-lane checks"
+fi
+
