{
  "schema": "xenia-operation-wal-anchor-benchmark-v0.1",
  "status": "preregistered_unmeasured",
  "scope": "Independent monotonic WAL-head witnessing and process-bound sequence leases",
  "implementation_status": {
    "typed_checkpoint_model": "implemented_in_branch",
    "hash_link_extension_verifier": "implemented_in_branch",
    "witness_quorum_signature_verifier": "implemented_in_branch",
    "process_bound_sequence_lease_model": "implemented_in_branch",
    "cached_verified_lease_token": "implemented_in_branch",
    "independent_durable_witness_service": "not_implemented",
    "live_operation_wal_integration": "not_implemented",
    "crash_restart_qualification": "not_implemented",
    "measured_results": false,
    "test_only_in_memory_cas_store": "implemented_in_branch"
  },
  "hard_invariants": {
    "witness_store_compare_and_advance_is_atomic": true,
    "witness_state_is_outside_local_wal_failure_domain": true,
    "candidate_checkpoint_must_extend_previous_hash_head": true,
    "stale_expected_checkpoint_fingerprint_is_rejected": true,
    "checkpoint_witness_generation_increments_exactly_one": true,
    "local_wal_rollback_is_rejected": true,
    "unanchored_local_suffix_blocks_new_privileged_mutations": true,
    "same_sequence_different_head_is_rejected": true,
    "witness_quorum_uses_distinct_pinned_keys": true,
    "zero_quorum_is_rejected": true,
    "sequence_leases_never_overlap": true,
    "unused_lease_range_is_burned_after_process_restart": true,
    "lease_is_bound_to_session_epoch_and_process_boot": true,
    "verified_lease_is_process_local_and_not_deserializable": true,
    "witness_signatures_are_verified_once_per_lease_not_per_frame": true,
    "unknown_witness_store_outcome_requires_readback_before_retry": true
  },
  "fault_scenarios": [
    {
      "id": "OWA-001",
      "name": "restore-local-wal-older-than-witness",
      "expected": "LocalWalRollback",
      "safety_assertion": "no_new_effect_admitted"
    },
    {
      "id": "OWA-002",
      "name": "restore-local-wal-same-sequence-different-hash",
      "expected": "LocalWalHeadMismatch",
      "safety_assertion": "no_new_effect_admitted"
    },
    {
      "id": "OWA-003",
      "name": "restore-local-wal-newer-than-witness",
      "expected": "UnanchoredWalSuffix",
      "safety_assertion": "suffix_must_be_witnessed_before_mutation"
    },
    {
      "id": "OWA-004",
      "name": "checkpoint-candidate-wrong-parent",
      "expected": "PreviousCheckpointMismatch",
      "safety_assertion": "no_fork_accepted"
    },
    {
      "id": "OWA-005",
      "name": "checkpoint-same-height-different-head",
      "expected": "WalFork",
      "safety_assertion": "no_fork_accepted"
    },
    {
      "id": "OWA-006",
      "name": "checkpoint-wal-sequence-regression",
      "expected": "WalSequenceRegressed",
      "safety_assertion": "no_rollback_accepted"
    },
    {
      "id": "OWA-007",
      "name": "checkpoint-extension-broken-link",
      "expected": "ExtensionBrokenLink",
      "safety_assertion": "no_invalid_suffix_accepted"
    },
    {
      "id": "OWA-008",
      "name": "checkpoint-extension-terminal-head-mismatch",
      "expected": "ExtensionHeadMismatch",
      "safety_assertion": "no_invalid_suffix_accepted"
    },
    {
      "id": "OWA-009",
      "name": "witness-quorum-one-of-three",
      "expected": "QuorumNotMet",
      "safety_assertion": "single_witness_cannot_authorize"
    },
    {
      "id": "OWA-010",
      "name": "untrusted-witness-added-to-bundle",
      "expected": "UntrustedWitness",
      "safety_assertion": "unknown_key_cannot_count_toward_quorum"
    },
    {
      "id": "OWA-011",
      "name": "duplicate-witness-key",
      "expected": "DuplicateWitness",
      "safety_assertion": "one_key_counts_once"
    },
    {
      "id": "OWA-012",
      "name": "invalid-witness-signature",
      "expected": "BadWitnessSignature",
      "safety_assertion": "tampered_checkpoint_rejected"
    },
    {
      "id": "OWA-013",
      "name": "stale-expected-head-cas-race",
      "expected": "StaleExpectedHead",
      "safety_assertion": "one_compare_and_advance_wins"
    },
    {
      "id": "OWA-014",
      "name": "witness-service-unknown-outcome",
      "expected": "ReadBackBeforeRetry",
      "safety_assertion": "no_new_range_or_checkpoint_before_reconciliation"
    },
    {
      "id": "OWA-015",
      "name": "witness-store-state-rollback",
      "expected": "IndependentMonotonicStoreAlarm",
      "safety_assertion": "old_witness_generation_not_accepted"
    },
    {
      "id": "OWA-016",
      "name": "restart-with-unused-sequence-lease",
      "expected": "BurnRemainingOldRange",
      "safety_assertion": "new_lease_starts_after_old_range_end"
    },
    {
      "id": "OWA-017",
      "name": "lease-reused-after-restart",
      "expected": "LeaseRangeReuse",
      "safety_assertion": "no_duplicate_sequence"
    },
    {
      "id": "OWA-018",
      "name": "wrong-process-boot-fingerprint",
      "expected": "BootFingerprintMismatch",
      "safety_assertion": "old_process_lease_cannot_resume"
    },
    {
      "id": "OWA-019",
      "name": "wrong-authority-epoch",
      "expected": "AuthorityEpochMismatch",
      "safety_assertion": "stale_authority_cannot_send"
    },
    {
      "id": "OWA-020",
      "name": "expired-sequence-lease",
      "expected": "LeaseExpired",
      "safety_assertion": "expired_range_cannot_send"
    },
    {
      "id": "OWA-021",
      "name": "operation-outside-lease-range",
      "expected": "OperationSequenceOutsideLease",
      "safety_assertion": "out_of_range_sequence_rejected"
    },
    {
      "id": "OWA-022",
      "name": "restart-with-local-sequence-below-reserved-high-water",
      "expected": "NextLeaseStartsAfterPriorEnd",
      "safety_assertion": "unused_sequences_are_never_reissued"
    },
    {
      "id": "OWA-023",
      "name": "two-processes-race-to-reserve-leases",
      "expected": "AtomicNonOverlappingRanges",
      "safety_assertion": "no_overlap_even_under_concurrent_issue"
    },
    {
      "id": "OWA-024",
      "name": "unavailable-witness-store",
      "expected": "FailClosed",
      "safety_assertion": "no_unwitnessed_high_water_advance"
    },
    {
      "id": "OWA-025",
      "name": "in-memory-reference-store-competing-checkpoint-cas",
      "expected": "ExactlyOneWinner",
      "safety_assertion": "stale_expected_head_is_rejected"
    },
    {
      "id": "OWA-026",
      "name": "invalid-extension-at-witness-store",
      "expected": "CandidateRejected",
      "safety_assertion": "retained_checkpoint_unchanged"
    },
    {
      "id": "OWA-027",
      "name": "lease-commit-response-lost",
      "expected": "ReadBackFindsCommittedRange",
      "safety_assertion": "caller_does_not_reserve_a_different_overlapping_range"
    },
    {
      "id": "OWA-028",
      "name": "two-processes-race-to-reserve-first-lease",
      "expected": "ExactlyOneLeaseWinner",
      "safety_assertion": "only_one_initial_range_is_committed"
    }
  ],
  "benchmark_matrix": {
    "witness_quorums": [
      "2-of-3",
      "3-of-5"
    ],
    "lease_spans": [
      1024,
      16384,
      262144,
      1048576
    ],
    "concurrency_levels": [
      1,
      8,
      32,
      128,
      512
    ],
    "operation_counts": [
      10000,
      1000000,
      10000000,
      100000000
    ],
    "workloads": [
      "frame-60fps",
      "audio-50fps",
      "telemetry-10hz",
      "file-chunk-stream",
      "mixed-lanes"
    ],
    "baselines": [
      "local-hash-chain-only-no-external-anchor",
      "per-operation-remote-witness-roundtrip",
      "witnessed-range-lease-with-local-constant-time-admission",
      "transparency-log-merkle-consistency-proof-reference"
    ],
    "failure_injection": [
      "witness-quorum-member-unavailable",
      "stale-cas-race",
      "witness-store-timeout-before-commit",
      "witness-store-timeout-after-commit",
      "process-kill-with-unused-lease",
      "snapshot-restore-with-old-lease",
      "clock-regression",
      "local-wal-truncation",
      "local-wal-old-valid-prefix-rollback",
      "same-height-fork",
      "compaction-and-checkpoint-transition"
    ]
  },
  "provisional_targets_not_results": {
    "cached_lease_range_check_p99_us": 1,
    "stable_operation_id_derivation_p99_us": 5,
    "local_sequence_admission_throughput_ops_per_second": 1000000,
    "lease_acquisition_p99_ms_same_region_2_of_3": 100,
    "unauthorized_rollback_accepts": 0,
    "sequence_range_overlaps": 0,
    "untrusted_witness_quorum_accepts": 0,
    "automatic_retries_after_unknown_witness_outcome": 0,
    "witness_signature_verifications_per_operation": 0
  },
  "measurement_requirements": {
    "record_cpu_os_toolchain_allocator_and_network_topology": true,
    "record_witness_regions_and_failure_domains": true,
    "report_p50_p95_p99_p999": true,
    "record_quorum_latency_and_availability": true,
    "record_operation_admission_cpu_cost": true,
    "record_lease_waste_fraction_after_crash": true,
    "record_witness_storage_durability_policy": true,
    "preserve_raw_samples_and_exact_commit_sha": true,
    "same_hardware_same_payload_same_fault_schedule": true,
    "separate_model_local_and_multi_region_results": true
  }
}
