    {
      "id": "M1-RACE-01",
      "family": "revocation_before_commit",
      "description": "Revocation becomes effective and is observed before the effect-owner linearization point. The operation must not dispatch.",
      "operation": {
        "id": "op:r01",
        "fingerprint": "sha256:fixture-r01",
        "lane": "InjectInput",
        "action_id": "xenia.input.inject",
        "direction": "viewer_to_host",
        "resource": "host:alpha/input",
        "session_epoch": 4,
        "authority_epoch": 12,
        "delegation": "del:child-1"
      },
      "schedule": [
        {
          "seq": 1,
          "event": "source_preflight_permit",
          "owner": "xenia-input"
        },
        {
          "seq": 2,
          "event": "revocation_observed",
          "owner": "xenia-input"
        },
        {
          "seq": 3,
          "event": "effect_owner_gate_denied",
          "owner": "xenia-input"
        }
      ],
      "faults": [],
      "notes": "The gate decision and dispatch are distinct. No platform injector call is made."
    },
